<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="manufacturing_passport_qc_template_view_list" model="ir.ui.view">
        <field name="name">manufacturing_passport.mrp.qc.template.view.list</field>
        <field name="model">mrp.qc.template</field>
        <field name="arch" type="xml">
            <list string="Шаблони перевірки">
                <field name="name"/>
                <field name="product_id"/>
                <field name="bom_id"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="manufacturing_passport_qc_template_view_form" model="ir.ui.view">
        <field name="name">manufacturing_passport.mrp.qc.template.view.form</field>
        <field name="model">mrp.qc.template</field>
        <field name="arch" type="xml">
            <form string="Шаблон перевірки якості">
                <sheet>
                    <widget name="web_ribbon" title="Архів" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="bom_id"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Параметри перевірки" name="lines">
                            <field name="line_ids">
                                <list editable="bottom" string="Параметри перевірки">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="parameter_type"/>
                                    <field name="method"/>
                                    <field name="uom"/>
                                    <field name="min_value"
                                           invisible="parameter_type == 'qualitative'"
                                           optional="show"/>
                                    <field name="max_value"
                                           invisible="parameter_type == 'qualitative'"
                                           optional="show"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Нотатки" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="manufacturing_passport_qc_template_view_search" model="ir.ui.view">
        <field name="name">manufacturing_passport.mrp.qc.template.view.search</field>
        <field name="model">mrp.qc.template</field>
        <field name="arch" type="xml">
            <search string="Пошук шаблонів">
                <field name="name" string="Назва"/>
                <field name="product_id" string="Продукт"/>
                <filter string="Активні" name="active" domain="[('active', '=', True)]"/>
                <filter string="Архів" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Групувати за">
                    <filter name="group_product" string="Продуктом" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="manufacturing_passport_qc_template_action" model="ir.actions.act_window">
        <field name="name">Шаблони перевірки</field>
        <field name="res_model">mrp.qc.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Створіть перший шаблон перевірки
            </p>
            <p>
                Шаблони перевірки містять перелік параметрів для контролю якості продукту.
            </p>
        </field>
    </record>
</odoo>
