<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="manufacturing_passport_qc_inspection_view_form" model="ir.ui.view">
        <field name="name">manufacturing_passport.mrp.qc.inspection.view.form</field>
        <field name="model">mrp.qc.inspection</field>
        <field name="arch" type="xml">
            <form string="Акт випробувань">
                <header>
                    <button name="action_start" type="object"
                            string="Розпочати перевірку"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_done" type="object"
                            string="Завершити перевірку"
                            class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_approve" type="object"
                            string="Затвердити"
                            class="btn-success"
                            invisible="state != 'done'"
                            groups="manufacturing_passport.group_qc_manager,mrp.group_mrp_manager"/>
                    <button name="action_reject" type="object"
                            string="Відхилити"
                            class="btn-danger"
                            invisible="state != 'done'"
                            groups="manufacturing_passport.group_qc_manager,mrp.group_mrp_manager"/>
                    <button name="action_reset_draft" type="object"
                            string="Повернути в чернетку"
                            invisible="state != 'rejected'"/>
                    <button name="action_print_inspection" type="object"
                            string="Друк акту"
                            invisible="state not in ('done', 'approved')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Основна інформація">
                            <field name="production_id"
                                   readonly="state not in ('draft', 'in_progress')"/>
                            <field name="product_id" readonly="1"/>
                            <field name="lot_id"
                                   readonly="state not in ('draft', 'in_progress')"/>
                            <field name="template_id"
                                   readonly="state not in ('draft', 'in_progress')"/>
                        </group>
                        <group string="Деталі перевірки">
                            <field name="inspector_id"
                                   readonly="state not in ('draft', 'in_progress')"/>
                            <field name="inspection_date"
                                   readonly="state not in ('draft', 'in_progress')"/>
                            <field name="result" widget="radio"
                                   readonly="state in ('approved', 'rejected')"/>
                            <field name="completion_rate" widget="percentage"/>
                            <field name="approved_by" invisible="state not in ('approved', 'rejected')"/>
                            <field name="approved_date" invisible="state not in ('approved', 'rejected')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Результати перевірки" name="results">
                            <field name="line_ids"
                                   readonly="state in ('approved', 'rejected')">
                                <list editable="bottom"
                                      string="Результати перевірки"
                                      decoration-danger="line_result == 'fail'"
                                      decoration-success="line_result == 'pass'"
                                      decoration-muted="line_result == 'not_checked'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="parameter_type"/>
                                    <field name="method" optional="show"/>
                                    <field name="uom" optional="show"/>
                                    <field name="min_value"
                                           invisible="parameter_type == 'qualitative'"
                                           optional="show"/>
                                    <field name="max_value"
                                           invisible="parameter_type == 'qualitative'"
                                           optional="show"/>
                                    <field name="actual_value"
                                           invisible="parameter_type == 'qualitative'"/>
                                    <field name="qualitative_result"
                                           invisible="parameter_type == 'quantitative'"/>
                                    <field name="line_result"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Примітки та вкладення" name="notes">
                            <field name="note"
                                   placeholder="Загальні висновки, зауваження..."
                                   readonly="state in ('approved', 'rejected')"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="manufacturing_passport_qc_inspection_view_list" model="ir.ui.view">
        <field name="name">manufacturing_passport.mrp.qc.inspection.view.list</field>
        <field name="model">mrp.qc.inspection</field>
        <field name="arch" type="xml">
            <list string="Акти випробувань"
                  decoration-danger="result == 'fail'"
                  decoration-success="result == 'pass' and state == 'approved'"
                  decoration-muted="state == 'rejected'">
                <field name="name"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="lot_id" optional="show"/>
                <field name="inspection_date"/>
                <field name="inspector_id"/>
                <field name="result"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'in_progress')"
                       decoration-warning="state == 'done'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="manufacturing_passport_qc_inspection_view_search" model="ir.ui.view">
        <field name="name">manufacturing_passport.mrp.qc.inspection.view.search</field>
        <field name="model">mrp.qc.inspection</field>
        <field name="arch" type="xml">
            <search string="Пошук актів перевірки">
                <field name="name" string="Номер"/>
                <field name="production_id" string="Виробниче замовлення"/>
                <field name="product_id" string="Продукт"/>
                <field name="inspector_id" string="Інспектор"/>
                <separator/>
                <filter string="Чернетки" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="В процесі" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Завершені" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Затверджені" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Відхилені" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Придатні" name="pass" domain="[('result', '=', 'pass')]"/>
                <filter string="Непридатні" name="fail" domain="[('result', '=', 'fail')]"/>
                <group expand="0" string="Групувати за">
                    <filter name="group_production" string="Виробничим замовленням"
                            context="{'group_by': 'production_id'}"/>
                    <filter name="group_product" string="Продуктом"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_state" string="Статусом"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_result" string="Результатом"
                            context="{'group_by': 'result'}"/>
                    <filter name="group_date" string="Датою перевірки"
                            context="{'group_by': 'inspection_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="manufacturing_passport_qc_inspection_action" model="ir.actions.act_window">
        <field name="name">Акти перевірки</field>
        <field name="res_model">mrp.qc.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Створіть перший акт перевірки
            </p>
            <p>
                Акти перевірки фіксують результати контролю якості готової продукції.
                Їх можна створити безпосередньо з виробничого замовлення після завершення виробництва.
            </p>
        </field>
    </record>
</odoo>
