<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="demo_qc_template_drone" model="mrp.qc.template">
        <field name="name">Перевірка FPV дрону</field>
        <field name="note"><![CDATA[<p>Шаблон для перевірки якості FPV дронів перед відвантаженням.</p>]]></field>
    </record>

    <record id="demo_qc_template_line_voltage" model="mrp.qc.template.line">
        <field name="template_id" ref="demo_qc_template_drone"/>
        <field name="sequence">10</field>
        <field name="name">Напруга живлення</field>
        <field name="parameter_type">quantitative</field>
        <field name="method">Мультиметр, вимірювання на клемах живлення</field>
        <field name="uom">В</field>
        <field name="min_value">10.5</field>
        <field name="max_value">12.6</field>
    </record>

    <record id="demo_qc_template_line_current" model="mrp.qc.template.line">
        <field name="template_id" ref="demo_qc_template_drone"/>
        <field name="sequence">20</field>
        <field name="name">Струм споживання в режимі очікування</field>
        <field name="parameter_type">quantitative</field>
        <field name="method">Амперметр, режим холостого ходу</field>
        <field name="uom">мА</field>
        <field name="min_value">0</field>
        <field name="max_value">150</field>
    </record>

    <record id="demo_qc_template_line_range" model="mrp.qc.template.line">
        <field name="template_id" ref="demo_qc_template_drone"/>
        <field name="sequence">30</field>
        <field name="name">Дальність зв'язку</field>
        <field name="parameter_type">quantitative</field>
        <field name="method">Польові випробування з вимірювачем рівня сигналу</field>
        <field name="uom">м</field>
        <field name="min_value">800</field>
        <field name="max_value">1500</field>
    </record>

    <record id="demo_qc_template_line_visual" model="mrp.qc.template.line">
        <field name="template_id" ref="demo_qc_template_drone"/>
        <field name="sequence">40</field>
        <field name="name">Візуальний огляд корпусу</field>
        <field name="parameter_type">qualitative</field>
        <field name="note">Перевірити відсутність тріщин, подряпин, механічних пошкоджень корпусу та рам.</field>
    </record>

    <record id="demo_qc_template_line_connectors" model="mrp.qc.template.line">
        <field name="template_id" ref="demo_qc_template_drone"/>
        <field name="sequence">50</field>
        <field name="name">Перевірка роз'ємів</field>
        <field name="parameter_type">qualitative</field>
        <field name="note">Перевірити надійність з'єднання всіх роз'ємів, відсутність окислення та люфту.</field>
    </record>

    <record id="demo_qc_template_line_return" model="mrp.qc.template.line">
        <field name="template_id" ref="demo_qc_template_drone"/>
        <field name="sequence">60</field>
        <field name="name">Тест автоповернення</field>
        <field name="parameter_type">qualitative</field>
        <field name="note">Активувати функцію Return-to-Home, переконатись що дрон повертається до точки зльоту.</field>
    </record>
</odoo>
