<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_product_passport" model="ir.actions.report">
        <field name="name">Паспорт виробу</field>
        <field name="model">mrp.product.passport</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">manufacturing_passport.report_product_passport</field>
        <field name="report_file">manufacturing_passport.report_product_passport</field>
        <field name="binding_model_id" ref="model_mrp_product_passport"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_product_passport">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Title -->
                        <div class="text-center mb-4">
                            <h2>ПАСПОРТ ВИРОБУ</h2>
                            <h3>№ <t t-esc="doc.name"/></h3>
                        </div>

                        <!-- Section 1: General information -->
                        <h4>1. Загальні відомості</h4>
                        <table class="table table-sm table-bordered mb-4" style="width:100%">
                            <tbody>
                                <tr>
                                    <th style="width:35%">Найменування виробу</th>
                                    <td><t t-esc="doc.product_id.display_name"/></td>
                                </tr>
                                <tr>
                                    <th>Серійний номер</th>
                                    <td><t t-esc="doc.lot_id.name or '—'"/></td>
                                </tr>
                                <tr>
                                    <th>Виробниче замовлення</th>
                                    <td><t t-esc="doc.production_id.name"/></td>
                                </tr>
                                <tr>
                                    <th>Виробник</th>
                                    <td>
                                        <t t-esc="doc.company_id.name"/>
                                        <t t-if="doc.company_id.street">
                                            , <t t-esc="doc.company_id.street"/>
                                        </t>
                                        <t t-if="doc.company_id.city">
                                            , <t t-esc="doc.company_id.city"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Дата виготовлення</th>
                                    <td>
                                        <t t-esc="doc.date_manufactured.strftime('%d.%m.%Y') if doc.date_manufactured else '—'"/>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Дата видачі паспорта</th>
                                    <td>
                                        <t t-esc="doc.date_issued.strftime('%d.%m.%Y') if doc.date_issued else '—'"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Section 2: Technical data from inspection -->
                        <t t-if="doc.inspection_id and doc.inspection_id.line_ids">
                            <h4>2. Основні технічні характеристики</h4>
                            <table class="table table-sm table-bordered mb-4" style="width:100%">
                                <thead>
                                    <tr style="background-color:#f5f5f5">
                                        <th style="width:4%">№</th>
                                        <th style="width:30%">Параметр</th>
                                        <th style="width:12%">Одиниця</th>
                                        <th style="width:16%">Норма</th>
                                        <th style="width:18%">Фактичне значення</th>
                                        <th style="width:20%">Висновок</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.inspection_id.line_ids" t-as="line">
                                        <tr>
                                            <td class="text-center">
                                                <t t-esc="line_index + 1"/>
                                            </td>
                                            <td><t t-esc="line.name"/></td>
                                            <td class="text-center"><t t-esc="line.uom or '—'"/></td>
                                            <td class="text-center">
                                                <t t-if="line.check_type == 'quantitative' and (line.min_value or line.max_value)">
                                                    <t t-esc="line.min_value"/>&#8202;–&#8202;<t t-esc="line.max_value"/>
                                                </t>
                                                <t t-else="">—</t>
                                            </td>
                                            <td class="text-center">
                                                <t t-if="line.check_type == 'quantitative'">
                                                    <t t-esc="line.actual_value"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-esc="line.qualitative_result or '—'"/>
                                                </t>
                                            </td>
                                            <td class="text-center">
                                                <t t-if="line.line_result == 'pass'">
                                                    <strong style="color:#28a745">ПРИДАТНИЙ</strong>
                                                </t>
                                                <t t-elif="line.line_result == 'fail'">
                                                    <strong style="color:#dc3545">НЕПРИДАТНИЙ</strong>
                                                </t>
                                                <t t-else="">НЕ ПЕРЕВІРЕНО</t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Section 3: Components / traceability -->
                        <h4>3. Комплектність</h4>
                        <t t-if="doc.component_line_ids">
                            <table class="table table-sm table-bordered mb-4" style="width:100%">
                                <thead>
                                    <tr style="background-color:#f5f5f5">
                                        <th style="width:4%">№</th>
                                        <th style="width:40%">Найменування комплектуючої</th>
                                        <th style="width:26%">Серійний номер / партія</th>
                                        <th style="width:16%">Кількість</th>
                                        <th style="width:14%">Одиниця</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.component_line_ids" t-as="comp">
                                        <tr>
                                            <td class="text-center">
                                                <t t-esc="comp_index + 1"/>
                                            </td>
                                            <td><t t-esc="comp.product_id.display_name"/></td>
                                            <td><t t-esc="comp.lot_id.name or '—'"/></td>
                                            <td class="text-center"><t t-esc="comp.quantity"/></td>
                                            <td><t t-esc="comp.uom_id.name or '—'"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p><em>Відомості про комплектуючі відсутні.</em></p>
                        </t>

                        <!-- Section 4: Acceptance certificate -->
                        <h4>4. Свідоцтво про приймання</h4>
                        <div class="mb-4 p-3" style="border:1px solid #ccc">
                            <p>
                                Виріб <strong><t t-esc="doc.product_id.display_name"/></strong>
                                серійний номер <strong><t t-esc="doc.lot_id.name or '—'"/></strong>
                                виготовлено та прийнято відповідно до вимог технічних умов.
                            </p>
                            <p>
                                Дата виготовлення:
                                <t t-esc="doc.date_manufactured.strftime('%d.%m.%Y') if doc.date_manufactured else '—'"/>.
                            </p>
                            <p class="mt-3">Штамп ОТК: _____________________</p>
                        </div>

                        <!-- Section 5: Warranty -->
                        <h4>5. Гарантійні зобов'язання</h4>
                        <div class="mb-4 p-3" style="border:1px solid #ccc">
                            <p>
                                Виробник гарантує відповідність виробу вимогам технічних умов
                                протягом <strong><t t-esc="doc.warranty_months"/></strong> місяців
                                з дати виготовлення.
                            </p>
                            <t t-if="doc.warranty_end">
                                <p>
                                    Гарантія дійсна до:
                                    <strong>
                                        <t t-esc="doc.warranty_end.strftime('%d.%m.%Y')"/>
                                    </strong>.
                                </p>
                            </t>
                        </div>

                        <!-- Notes -->
                        <t t-if="doc.note">
                            <div class="mb-4">
                                <strong>Примітки:</strong>
                                <p><t t-esc="doc.note"/></p>
                            </div>
                        </t>

                        <!-- Signatures -->
                        <div class="row mt-5">
                            <div class="col-4">
                                <p>
                                    Виготовив: ________________________
                                    <br/><small>(підпис, дата)</small>
                                </p>
                            </div>
                            <div class="col-4">
                                <p>
                                    Перевірив (ОТК): ________________________
                                    <br/>
                                    <small>
                                        (<t t-if="doc.inspection_id and doc.inspection_id.approved_by">
                                            <t t-esc="doc.inspection_id.approved_by.name"/>
                                        </t>
                                        <t t-else="">посада, підпис</t>)
                                    </small>
                                </p>
                            </div>
                            <div class="col-4">
                                <p>
                                    Затвердив: ________________________
                                    <br/><small>(посада, підпис)</small>
                                </p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
